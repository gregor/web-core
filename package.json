{
  "name": "@gregor_herdmann/web-core",
  "version": "2.6.3",
  "description": "Shared toolchain and runtime dependencies for the web-* apps",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregor/web-core.git"
  },
  "bin": {
    "web-core": "bin/web-core.js"
  },
  "files": [
    "bin",
    "config",
    "dist",
    "lib",
    "tsconfig.base.json",
    "tsconfig.server.base.json"
  ],
  "exports": {
    "./eslint": "./config/eslint.js",
    "./prettier": "./config/prettier.js",
    "./vite": "./config/vite.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.server.base.json": "./tsconfig.server.base.json",
    "./package.json": "./package.json",
    "./client": "./config/client.d.ts",
    "./vitest-setup": "./config/vitest-setup.js",
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui.css": "./config/ui.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.ui.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "sync-peers": "node scripts/sync-peers.mjs",
    "test": "node test/prepare-fixture.mjs && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "googleapis": "182.0.0",
    "i18next": "26.5.10",
    "lucide-react": "1.61.0",
    "memorystore": "1.6.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "cors": "~2.8.6",
    "date-fns": "~4.4.0",
    "express": "~5.3.0",
    "express-session": "~1.19.0",
    "googleapis": "~182.0.0",
    "i18next": "~26.5.3",
    "lucide-react": "~1.61.0",
    "memorystore": "~1.6.8",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.1.0",
    "react-router-dom": "~7.18.4",
    "recharts": "~3.10.1",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "./config/prettier.js"
}
